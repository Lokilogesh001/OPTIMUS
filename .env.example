# ==============================================================================
# OPTIMUS Environment Configuration Template (.env.example)
# Copy this file to .env and configure for your local environment.
# Never commit active secrets or API credentials to source repositories.
# ==============================================================================

# --- System & Storage Settings ---
OPTIMUS_STORAGE_ROOT=./memory
OPTIMUS_LOG_LEVEL=INFO
OPTIMUS_DEBUG=false

# --- Operational Routing Policy ---
# Options: LOCAL_FIRST, PRIVACY_STRICT, CLOUD_PREFERRED, COST_OPTIMIZED, PERFORMANCE_OPTIMIZED
OPTIMUS_ROUTING_POLICY=LOCAL_FIRST

# --- Local Inference (Ollama) ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_DEFAULT_MODEL=qwen3.5:4b-q4_K_M

# --- Cloud Model Providers (Optional) ---
# Provide keys only if cloud routing is permitted by your security policy.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# --- Voice & Speech Intelligence ---
OPTIMUS_ENABLE_VOICE=true
OPTIMUS_WAKE_WORD=optimus
OPTIMUS_SPEECH_DEDUPLICATION_WINDOW_MS=1500

# --- Hardware Optimization (NVIDIA RTX 3050 4GB) ---
OPTIMUS_MAX_GPU_VRAM_MB=3800
OPTIMUS_ENABLE_CPU_OFFLOAD=true
